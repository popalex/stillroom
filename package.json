{
  "name": "secure-image-viewer",
  "version": "0.1.0",
  "description": "A private image gallery with browser-side encryption",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite\"",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "backup": "tsx server/backup.ts",
    "format": "prettier --write scripts src server shared tests *.ts *.json *.yaml",
    "format:check": "prettier --check scripts src server shared tests *.ts *.json *.yaml",
    "setup:tailscale": "node scripts/setup-tailscale.mjs"
  },
  "type": "module",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "libsodium-wrappers-sumo": "^0.8.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.5.2"
}
